<style amp-custom>
*{box-sizing:border-box;margin:0;padding:0}
:focus{outline:0}
::-webkit-scrollbar{display:none}
*{user-select:none}

html{
  max-width:500px;
  margin:0 auto;
  background:
    radial-gradient(circle at top center,rgba(255,221,107,.22),transparent 24%),
    radial-gradient(circle at top left,rgba(255,170,0,.18),transparent 34%),
    radial-gradient(circle at top right,rgba(255,238,150,.14),transparent 32%),
    radial-gradient(circle at bottom,rgba(191,118,0,.20),transparent 48%),
    linear-gradient(180deg,#050505 0%,#121008 44%,#030303 100%);
}

body{
  color:#fff8df;
  font-family:'Noto Sans',arial,sans-serif;
  background:
    linear-gradient(180deg,rgba(255,215,90,.05),rgba(0,0,0,0) 32%),
    transparent;
}

a,a:after,a:hover,a:visited{
  text-decoration:none;
  color:#ffd76a;
  font-weight:900;
}

.wrap{padding:12px}
.center{text-align:center}

.togel-online{
  display:flex;
  align-items:center;
  justify-content:center;
  width:40px;
  height:40px;
  border-radius:50%;
  background:transparent;
  color:#fff7d0;
  transition:.3s;
  cursor:pointer;
}

.togel-online:hover{transform:translateY(-3px)}
.bandar-togel{text-align:center}
.bonengjitu-togel{display:grid}

.bonengjitu-togel .contole{
  padding:.5rem 3.8rem;
  background:rgba(8,7,3,.90);
  margin-bottom:.5rem;
  border-radius:.45rem;
  border:1px solid rgba(255,215,100,.55);
  box-shadow:
    inset 0 1px 0 rgba(255,246,190,.20),
    0 0 14px rgba(255,184,40,.35),
    0 0 26px rgba(0,0,0,.85);
  letter-spacing:1px;
}

.bonengjitu-togel a.btn1{
  color:#130d00;
  background-image:linear-gradient(135deg,#fff2a8 0,#d8a72e 48%,#7b4b00 100%);
  font-weight:900;
}

.bonengjitu-togel-container{
  display:flex;
  background:linear-gradient(135deg,#0b0a05 0,#7a4b00 52%,#f5c64b 100%);
  width:250px;
  height:40px;
  align-items:center;
  justify-content:space-around;
  border-radius:10px;
  box-shadow:0 0 18px rgba(255,190,55,.52);
}

.btn2{
  margin-bottom:20px;
  display:flex;
  justify-content:center;
  align-items:center;
  width:100%;
  overflow:hidden;
  height:3rem;
  border-radius:.45rem;
  transition:.5s;
  animation:gradient_301 5s ease infinite;
  position:relative;
  z-index:1;
  border:2px solid #f5c64b;
  background-image:linear-gradient(90deg,#050505,#171104,#2b1c00,#0a0905);
  text-shadow:
    0 0 6px rgba(255,240,170,.95),
    0 0 14px rgba(255,185,42,.80),
    0 0 24px rgba(255,127,0,.45);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.18),
    0 0 14px rgba(255,197,65,.66),
    0 0 30px rgba(255,142,0,.30),
    0 6px 0 rgba(41,24,0,.95);
}

.btn2:hover{
  transform:scale(1.05);
  filter:brightness(1.18);
  box-shadow:
    inset 0 0 16px rgba(255,231,135,.65),
    0 0 24px #ffe27a,
    0 0 44px #c88610,
    0 0 65px rgba(255,129,0,.62);
}

.btn2 strong{
  letter-spacing:2px;
  z-index:2;
  color:#fff8dc;
}

.btn2:before{
  content:"";
  position:absolute;
  inset:-4px;
  background:linear-gradient(45deg,#fff2a8,#e0ad36,#8a5300,#ffd76a,#fff2a8);
  border-radius:.55rem;
  z-index:-2;
  filter:blur(15px);
  opacity:.70;
  animation:pulse 2s infinite;
}

#container-stars{
  position:absolute;
  z-index:-1;
  width:100%;
  height:100%;
  overflow:hidden;
  transition:.5s;
  border-radius:.45rem;
}

.btn2:hover #container-stars{
  z-index:1;
  background-color:#070603;
}

#stars{
  position:relative;
  background:0 0;
  width:200rem;
  height:200rem;
}

#stars::after{
  content:"";
  position:absolute;
  top:-10rem;
  left:-100rem;
  width:100%;
  height:100%;
  animation:animStarRotate 90s linear infinite;
  background-image:radial-gradient(#fff6c7 1px,transparent 1%);
  background-size:50px 50px;
}

#stars::before{
  content:"";
  position:absolute;
  top:0;
  left:-50%;
  width:170%;
  height:500%;
  animation:animStar 60s linear infinite;
  background-image:radial-gradient(#d9a52c 1px,transparent 1%);
  background-size:50px 50px;
  opacity:.58;
}

#glow{
  position:absolute;
  display:flex;
  width:12rem;
}

.circle{
  width:100%;
  height:30px;
  filter:blur(2rem);
  animation:pulse_3011 4s infinite;
  z-index:-1;
}

.circle:nth-of-type(1){background:rgba(255,221,107,.72)}
.circle:nth-of-type(2){background:rgba(189,108,0,.68)}

.block-img{
  position:relative;
  margin:12px auto 20px;
  min-width:100px;
  background:#070603;
  border-radius:12px;
  z-index:1;
  padding:3px;
  color:#fff8df;
  cursor:pointer;
}

.block-img:before,
.block-img:after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(45deg,#fff2a8,#d9a52c,#6d4300,#ffcf54,#fff2a8);
  background-size:200%;
  z-index:-1;
  animation:steam 5s linear infinite;
  border-radius:12px;
}

.block-img:after{
  filter:blur(25px);
  opacity:.88;
}

.block-img amp-img{
  border-radius:10px;
  display:block;
}

.block1{
  position:relative;
  margin:auto;
  min-width:100px;
  padding:5px 10px;
  background:linear-gradient(0deg,#171104,#050505);
  color:#fff8df;
  cursor:pointer;
  border-radius:10px;
}

.block1:before,
.block1:after,
.block:before,
.block:after{
  content:'';
  position:absolute;
  right:-3px;
  bottom:-3px;
  background:linear-gradient(90deg,#fff2a8 0,#d8a72e 45%,#8a5300 72%,#ffd76a 100%);
  background-size:400%;
  width:calc(100% + 6px);
  height:calc(100% + 6px);
  z-index:-1;
  animation:steam 5s linear infinite;
  border-radius:10px;
}

.block{
  position:relative;
  padding:10px;
  background:linear-gradient(180deg,#171104 0%,#080704 58%,#030303 100%);
  color:#fff8df;
  cursor:pointer;
  margin-bottom:20px;
  border-radius:12px;
  border:1px solid rgba(255,215,100,.22);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.12),
    0 0 18px rgba(255,186,42,.22);
}

.block:after{filter:blur(36px);opacity:.74}

.logo{text-align:center}
.logo amp-img{width:100px;height:100px}

.artikel{
  padding:8px 0;
  text-align:justify;
}

.artikel h1,
.artikel h2{
  color:#ffd76a;
  text-align:center;
  text-shadow:
    0 0 10px rgba(255,222,118,.68),
    0 0 20px rgba(215,151,25,.55),
    0 0 34px rgba(255,119,0,.32);
}

.artikel p{margin:18px 0;color:#fff1c2}
.artikel a{color:#ffd76a}

.footer{
  text-align:center;
  margin:16px 0;
  color:#d9b75c;
  text-shadow:0 0 10px rgba(255,214,106,.35);
}

.footer a{color:#ffd76a}

.cta-list{
  display:grid;
  gap:10px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:8px;
}

hr{
  border:0;
  height:1px;
  background:linear-gradient(90deg,transparent,#d8a72e,transparent);
  box-shadow:0 0 12px rgba(255,215,100,.45);
}

@media (min-width:576px){
  .cards{grid-template-columns:repeat(4,1fr)}
}

@keyframes animStar{from{transform:translateY(0)}to{transform:translateY(-135rem)}}
@keyframes animStarRotate{from{transform:rotate(360deg)}to{transform:rotate(0)}}
@keyframes gradient_301{0%{background-position:0 50%}50%{background-position:100% 50%}100%{background-position:0 50%}}
@keyframes pulse_3011{0%{transform:scale(.75);box-shadow:0 0 0 0 rgba(255,221,107,.65)}70%{transform:scale(1);box-shadow:0 0 0 10px transparent}100%{transform:scale(.75);box-shadow:0 0 0 0 transparent}}
@keyframes steam{0%{background-position:0 0}50%{background-position:400% 0}100%{background-position:0 0}}
@keyframes pulse{0%{opacity:.38}50%{opacity:.88}100%{opacity:.38}}
</style>
